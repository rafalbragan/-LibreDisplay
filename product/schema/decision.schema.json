{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://librecare.product/schema/decision.schema.json",
  "title": "LibreCare Product Decision",
  "description": "A meaningful product decision. Kept so AI does not repeatedly re-propose rejected or postponed ideas.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "date",
    "subject",
    "status",
    "decision",
    "reason",
    "evidence",
    "counterargument",
    "revisit_condition",
    "related_requirements"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DEC-[0-9A-Za-z._-]+$"
    },
    "date": {
      "type": "string",
      "description": "ISO-8601 date."
    },
    "subject": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["ACCEPTED", "HOLD", "REJECTED", "SUPERSEDED"]
    },
    "decision": {
      "type": "string",
      "description": "The decision made."
    },
    "reason": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "counterargument": {
      "type": "string",
      "description": "The strongest opposing view that was considered."
    },
    "revisit_condition": {
      "type": "string",
      "description": "Under what future condition this should be revisited."
    },
    "related_requirements": {
      "type": "array",
      "items": { "type": "string", "pattern": "^REQ-[0-9A-Za-z._-]+$" }
    }
  }
}

