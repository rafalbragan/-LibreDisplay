<?xml version="1.0" encoding="utf-8"?>
<!--
    LibreCare data extraction rules (Android 12+).

    cloud-backup  -> Google One / cloud backup
    device-transfer -> direct device to device transfer (Samsung Smart Switch, Google cable/Wi-Fi
                       transfer and every other OEM tool built on the Android transfer API)
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="backup/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="backup/" />
    </device-transfer>
</data-extraction-rules>

